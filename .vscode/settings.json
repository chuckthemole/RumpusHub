{
    // =========================================================
    // Java Runtime / Build Behavior
    // =========================================================
    "java.autobuild.enabled": false,
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.import.gradle.enabled": true,
    "java.project.importOnFirstTimeStartup": "automatic",
    "java.configuration.runtimes": [],
    // Prevent noisy analysis edge cases
    "java.compile.nullAnalysis.mode": "automatic",
    // JVM tuning for large monorepos
    "java.jdt.ls.vmargs": "-Xms512m -Xmx4g",
    // =========================================================
    // Java Formatting
    // =========================================================
    "[java]": {
        "editor.defaultFormatter": "redhat.java",
        "editor.formatOnSave": true
    },
    "java.format.settings.url": "config/formatting/java-formatter.xml",
    "java.format.settings.profile": "RumpusStyle",
    // Prevent automatic import rewrites on save (explicit control only)
    "editor.codeActionsOnSave": {
        "source.organizeImports": "never"
    },
    // =========================================================
    // Java Import / Project Noise Reduction
    // =========================================================
    "java.import.exclusions": [
        "**/node_modules/**",
        "**/.gradle/**",
        "**/build/**",
        "**/out/**",
        "**/target/**",
        "**/dist/**",
        "**/tmp/**",
        "**/.idea/**",
        "**/coverage/**",
        "**/__pycache__/**",
        "**/rumpusenv/**",
    ],
    // =========================================================
    // Search Performance (critical in monorepos)
    // =========================================================
    "search.exclude": {
        "**/.gradle": true,
        "**/build": true,
        "**/out": true,
        "**/target": true,
        "**/dist": true,
        "**/tmp": true,
        "**/node_modules": true,
        "**/.idea": true,
        "**/coverage": true,
        "**/rumpusenv": true,
        "**/__pycache__": true
    },
    "search.followSymlinks": false,
    // =========================================================
    // File Watching (performance-critical)
    // =========================================================
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.gradle/**": true,
        "**/build/**": true,
        "**/out/**": true,
        "**/target/**": true,
        "**/dist/**": true,
        "**/tmp/**": true,
        "**/node_modules/**": true,
        "**/.idea/**": true,
        "**/coverage/**": true,
        "**/rumpusenv/**": true,
        "**/__pycache__/**": true
    },
    // =========================================================
    // File Associations (Java ecosystem correctness)
    // =========================================================
    "files.associations": {
        "*.gradle.kts": "kotlin",
        "*.kt": "kotlin",
        "*.gradle": "groovy",
        "settings.gradle": "groovy",
        "build.gradle": "groovy"
    },
    // =========================================================
    // Kotlin (only if present in JVM stack)
    // =========================================================
    "[kotlin]": {
        "editor.defaultFormatter": "JetBrains.kotlin-server",
        "editor.formatOnSave": false
    },
    "kotlin.formatter": "idea",
    // =========================================================
    // Groovy (Gradle scripts)
    // =========================================================
    "[groovy]": {
        "editor.formatOnSave": false
    },
}